# Database. SQLite locally; a postgresql:// URL when deployed (serverless
# filesystems are ephemeral, so SQLite cannot survive there). The Prisma
# provider follows this URL automatically via scripts/sync-db-provider.mjs.
DATABASE_URL="file:./prisma/dev.db"

# Claude, used to parse pasted event text into a structured draft.
# Without it the app still runs: link ingestion falls back to manual entry.
ANTHROPIC_API_KEY=""

# Set to 1 to fill an EMPTY database with the demo content on first request.
# For fresh deployments on hosts that give you no shell to run the seed in.
# It never runs against a database that already has activities in it.
ALLOW_AUTO_SEED=""

# Set to 1 to stub geocoding and weather with deterministic fixtures.
# Useful offline, in CI, and in sandboxes without outbound network access.
MOCK_EXTERNAL=""

# Public base URL, used to build absolute OpenGraph URLs for shared links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
