# Database — SQLite for local dev. Swap to a Postgres URL and change the
# datasource provider in prisma/schema.prisma to deploy.
DATABASE_URL="file:./dev.db"

# Claude, used to parse pasted event text into a structured draft.
# Without it the app still runs: link ingestion falls back to manual entry.
ANTHROPIC_API_KEY=""

# Set to 1 to stub geocoding and weather with deterministic fixtures.
# Useful offline, in CI, and in sandboxes without outbound network access.
MOCK_EXTERNAL=""

# Public base URL, used to build absolute OpenGraph URLs for shared links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
